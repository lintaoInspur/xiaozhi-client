{
  "llm": {
    "provider": "openai",
    "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "apiKey": "sk-你的DashScopeKey",
    "model": "qwen-plus"
  },
  "mcpServers": {
    "search": {
      "command": "node",
      "args": ["/app/mcps/search-mcp/run.js"],
      "env": {
        "SEARCH_BACKEND": "searxng",
        "SEARXNG_URL": "http://searxng:8080"
      }
    },
    "xiaozhi-music": {
      "command": "python3",
      "args": ["/opt/music-mcp/xiaozhi_music_mcp.py"],
      "env": {
        "XIAOZHI_BRIDGE": "http://xiaozhi-client:3000",
        "MUSIC_DIR": "/music"
      },
      "transport": "stdio"
    },
    "kids-encyclopedia": {
      "command": "node",
      "args": ["/app/mcps/kids-encyclopedia-mcp/run.js"]
    },
    "story": {
      "command": "node",
      "args": ["/app/mcps/story-mcp/run.js"]
    },
    "riddle": {
      "command": "node",
      "args": ["/app/mcps/riddle-mcp/run.js"]
    },
    "poems": {
      "command": "node",
      "args": ["/app/mcps/poems-mcp/run.js"]
    },
    "kids-math": {
      "command": "node",
      "args": ["/app/mcps/kids-math-mcp/run.js"]
    },
    "english": {
      "command": "node",
      "args": ["/app/mcps/english-mcp/run.js"]
    }
  }
}
