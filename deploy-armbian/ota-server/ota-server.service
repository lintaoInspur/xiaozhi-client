[Unit]
Description=XiaoZhi Intranet OTA Check Server
After=network.target

[Service]
Type=simple
# 改成你的实际路径与参数
WorkingDirectory=/opt/ota-server
Environment=OTA_PORT=8080
Environment=FIRMWARE_VERSION=2.5.8
Environment=FIRMWARE_FILE=/opt/ota-server/xiaozhi.bin
Environment=WEBSOCKET_URL=ws://192.168.1.10:3000/ws
Environment=OTA_FORCE=0
ExecStart=/usr/bin/python3 /opt/ota-server/ota-server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
