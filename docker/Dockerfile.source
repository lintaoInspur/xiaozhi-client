# 从源码构建 xiaozhi-client
# 与官方 docker/Dockerfile 的区别：官方镜像从 npm 拉「已发布」的包，
# 不会包含你 fork 里的本地改动（如音乐桥接）。本 Dockerfile 直接基于仓库源码
# 执行 pnpm build，因此会包含你 fork 的全部代码。
#
# 用法（在 armbian / 任意支持 Docker 的机器上，仓库根目录执行）：
#   docker build -f docker/Dockerfile.source -t xiaozhi-client:source .
# 或配合 docker-compose.source.yml：
#   docker compose -f docker/docker-compose.source.yml up -d --build
# BASE_IMAGE：默认 node:22；在受限/国内网络可传
#   --build-arg BASE_IMAGE=docker.m.daocloud.io/library/node:22
# 走 Docker Hub 镜像代理（daocloud 等）。
ARG BASE_IMAGE=node:22
FROM ${BASE_IMAGE}

# NPM_REGISTRY：默认官方源；国内可传
#   --build-arg NPM_REGISTRY=https://registry.npmmirror.com/
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV npm_config_registry=${NPM_REGISTRY}

# PNPM_LINKER：默认 hoisted（扁平 node_modules）。
# 原因：本项目用 pnpm workspace，src/web 的 devDependency（如 rollup-plugin-visualizer）
# 在默认隔离布局下只软链到 src/web/node_modules，而 vite 把临时配置写到
# /app/node_modules/.vite-temp，从该路径解析不到子包依赖导致 build:web 失败。
# 用 hoisted 链接器把所有依赖扁平化到 /app/node_modules 即可解决（仅影响容器内布局）。
ARG PNPM_LINKER=hoisted
ENV npm_config_node_linker=${PNPM_LINKER}

ENV DEBIAN_FRONTEND=noninteractive

# 系统依赖：ffmpeg 用于音频处理，python3 用于模板初始化，dumb-init 作为 PID 1
RUN apt-get update && apt-get install -y \
    dumb-init \
    git \
    ffmpeg \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm

WORKDIR /app

# 先拷贝依赖清单并安装，利用 Docker 层缓存（改源码不会让这一步失效）
COPY package.json pnpm-lock.yaml ./
# 注意：这里不使用 --frozen-lockfile。因为宿主环境无法运行 pnpm（部分部署机 node 不可用），
# 锁文件可能落后于 package.json（如新增 bonjour）。容器内重新解析依赖，保证改动生效。
RUN pnpm install

# 再拷贝全部源码并构建（server + cli + web）
COPY . .
RUN pnpm build

# 构建少儿离线 MCP 子项目（kids-encyclopedia / story / riddle / poems / kids-math / english）
# 产物为各包 dist/run.js，供 xiaozhi.config.json 以容器内路径 /app/mcps/<name>/dist/run.js 拉起
RUN pnpm --filter '@xiaozhi-client/*-mcp' build

ENV NODE_ENV=production
ENV XIAOZHI_WORKSPACE=/workspaces
ENV XIAOZHI_CONTAINER=true
ENV XIAOZHI_CONFIG_DIR=/workspaces

EXPOSE 9999 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node /app/dist/cli/index.js --version > /dev/null 2>&1 || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "/app/dist/cli/index.js", "start"]
